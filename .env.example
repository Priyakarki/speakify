# ---- Required ----
MONGO_URI=mongodb://127.0.0.1:27017/bolobuddy
JWT_SECRET=replace-with-a-long-random-string

# ---- Speaking Practice (all optional, free, no API keys) ----
# Open-source Whisper model run locally by Transformers.js.
WHISPER_MODEL=onnx-community/whisper-base_timestamped
# q8 = smaller/faster download (~80 MB). Use fp32 for the full-precision model.
WHISPER_DTYPE=q8
# Where the downloaded model is cached (default: backend/.models)
# MODEL_CACHE_DIR=
# Longest recording accepted, in seconds.
SPEAKING_MAX_SECONDS=60

# ---- AI Story Reading Analysis: POST /api/ai/analyze-speaking (optional) ----
# Max upload size in MB and max recording length in seconds.
AI_MAX_AUDIO_MB=25
AI_MAX_AUDIO_SECONDS=300
# Only if you want to use your own ffmpeg instead of the bundled ffmpeg-static:
# FFMPEG_PATH=
